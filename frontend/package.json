{
  "name": "storyweave-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "shoot": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.local/ms-playwright node scripts/shoot.mjs",
    "test:fence": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.local/ms-playwright playwright test tests/fence.spec.ts",
    "test:style": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.local/ms-playwright playwright test tests/style.spec.ts",
    "test:geometry": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.local/ms-playwright playwright test tests/geometry.spec.ts",
    "lint:design": "node scripts/lint-design.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "cytoscape": "^3.30.2",
    "cytoscape-cola": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.21.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
