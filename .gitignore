# --- Virtual environments (off the C: drive, never committed) ---
.venv/
.venv-ml/

# --- Local setup caches (pip/npm/HF/torch), kept off the C: drive (this-session setup) ---
.local/

# --- Databases (SQLite is local source of truth, rebuildable; not committed) ---
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Raw novel text (copyrighted / large; samples/ and labels/ ARE committed) ---
data/raw/*
!data/raw/.gitkeep

# --- Session-seed prompt files (local working notes; never committed) ---
*-prompt.md

# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Frontend (Phase 8) ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Visual-gate tooling (Playwright browsers + local screenshots; never committed) ---
.pw-cache/
.shots/
test-results/
playwright-report/

# --- Vector store artifacts (rebuildable) ---
.chroma/
*.faiss

# --- Model weights cache (HuggingFace; large, on F:, re-downloadable) ---
.hf-cache/

# --- LLM runner + GGUF weights (Phase 7b; large, on F:, re-downloadable) ---
.llm-cache/
# The llama.cpp runner drops large binaries in tools/; those stay ignored. The
# measurement harness (tools/*.py, added for the evidence phase) is source and is tracked.
tools/*
!tools/*.py

# --- Evidence artifacts (tools/run_evidence.py) ---
# The raw screenshots are ~39MB of regenerable intermediates: re-run tools/capture.py.
# The plates, plots, CSVs and REPORT.md ARE committed, so REPORT.md renders on GitHub.
evidence/shots/*.png

# --- Local scratch / planning notes (not project deliverables) ---
SKILL.md
next_steps.md
